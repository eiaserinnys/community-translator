{
  "name": "community-translator",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "contracts:check": "pnpm --filter @community-translator/contracts check:generated",
    "contracts:generate": "pnpm --filter @community-translator/contracts generate",
    "deploy:check": "node deploy/scripts/verify-deployment.mjs && node --test deploy/scripts/verify-deployment.test.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "pnpm deploy:check && turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.5"
  }
}
