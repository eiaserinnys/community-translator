HOST=127.0.0.1
PORT=3119
# openssl rand -hex 32, entered directly into the mode 600 file on the host.
TRANSLATOR_BEARER_TOKEN=replace-at-deploy-time
TRANSLATOR_CODEX_MODEL=gpt-5.6-luna
# codex 0.153.4 accepts minimal | low | medium | high | xhigh. There is no "max":
# model_reasoning_effort="max" is rejected and every request would fail.
TRANSLATOR_CODEX_REASONING_EFFORT=xhigh
TRANSLATOR_CODEX_CONCURRENCY=2
TRANSLATOR_CODEX_QUEUE_LIMIT=32
TRANSLATOR_CODEX_TIMEOUT_MS=120000
TRANSLATOR_GLOSSARY_FILE=/home/eias/services/community-translator/shared/glossary.yaml
